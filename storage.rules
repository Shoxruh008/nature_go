rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // firestore.rules bilan bir xil (admin parol bilan kiradi, email_verified talab qilinmaydi).
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'evolution2024team@gmail.com';
    }

    function isSmallImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
    }

    // Admin panel ichma-ich yo'llarga yuklaydi (places/{id}/routes/...): o'qish hammaga ochiq.
    match /places/{path=**} {
      allow read: if true;
    }

    // Joy rasmlari (add_place_screen)
    match /places/{file} {
      allow read: if true;
      allow create: if isSignedIn() && isSmallImage();
      allow update, delete: if isAdmin();
    }

    // Sharh rasmlari. Sharh yozilmay qolsa, yuklangan rasmlarni ilova
    // o'zi o'chirishi uchun delete ruxsat etilgan (reviewId tasodifiy).
    match /reviews/{reviewId}/{file} {
      allow read: if true;
      allow create: if isSignedIn() && isSmallImage();
      allow delete: if isSignedIn();
      allow update: if isAdmin();
    }

    // Marshrut fayllari (GPX/KML/GeoJSON)
    match /routes/{file} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
